# GrabInsta — copy to .env locally, or set these in hPanel > Node.js Web App > Environment variables.
# No real credentials go here. There is no Instagram login in v1.

# Port is assigned by Hostinger. Do NOT set PORT in hPanel; the app reads process.env.PORT.
# PORT=3000

NODE_ENV=production

# Extraction adapter: instagram-url-direct (default). See src/extractors/index.js.
# EXTRACTOR=instagram-url-direct

# Upstream timeout for one extraction attempt, in milliseconds. Keep <= 15000.
# UPSTREAM_TIMEOUT_MS=12000

# Local rate limit: max resolve requests per IP per window.
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# Max concurrent upstream extractions. Keep low on shared hosting.
# MAX_CONCURRENT_EXTRACTIONS=2

# Cache: max entries and TTL in milliseconds.
# CACHE_MAX_ENTRIES=100
# CACHE_TTL_MS=300000
